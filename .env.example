# Django
# Em produção, gere uma chave forte com:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-aleatoria-com-mais-de-50-caracteres
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de Dados ('sqlite' para execução local simples ou 'mysql' para MySQL 8.4 / Docker)
DB_ENGINE=sqlite
DB_NAME=feira_virtual
DB_USER=feira_user
DB_PASSWORD=troque-por-uma-senha-forte
DB_HOST=127.0.0.1
DB_PORT=3306

# Docker Compose MySQL (usado quando subir via docker compose)
MYSQL_DATABASE=feira_virtual
MYSQL_USER=feira_user
MYSQL_PASSWORD=troque-por-uma-senha-forte
MYSQL_ROOT_PASSWORD=troque-por-uma-senha-root-forte

# Segurança, Cookies, CORS e CSRF
CORS_ALLOW_ALL_ORIGINS=0
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
JWT_COOKIE_SECURE=0
JWT_COOKIE_SAMESITE=Lax
SERVE_MEDIA=1

# Rate Limiting
THROTTLE_ANON=100/minute
THROTTLE_USER=1000/minute
THROTTLE_AUTH=20/minute
